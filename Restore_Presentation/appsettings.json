{
  "$schema": "appsettings-schema.json",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    }
  },
  "Umbraco": {
    "CMS": {
      "Imaging": {
        "Cache": {
          "BrowserMaxAge": "7.00:00:00",
          "CacheMaxAge": "365.00:00:00"
        }
      },
      "Global": {
        "Id": "ee54554d-3d97-4888-b992-7e68ec57bfba",
        "UseHttps": true,
        "SanitizeTinyMce": true
      },
      "RequestHandler": {
        "AddTrailingSlash": true,
        "ConvertUrlsToAscii": "try",
        "EnableDefaultCharReplacements": true,
        "UserDefinedCharCollection": [
          {
            "Char": " ",
            "Replacement": "-"
          },
          {
            "Char": "\\",
            "Replacement": ""
          },
          {
            "Char": "\u0027",
            "Replacement": ""
          },
          {
            "Char": "%",
            "Replacement": ""
          },
          {
            "Char": ".",
            "Replacement": ""
          },
          {
            "Char": ";",
            "Replacement": ""
          },
          {
            "Char": "/",
            "Replacement": ""
          },
          {
            "Char": "\\\\",
            "Replacement": ""
          },
          {
            "Char": ":",
            "Replacement": ""
          },
          {
            "Char": "#",
            "Replacement": ""
          },
          {
            "Char": "\u002B",
            "Replacement": "plus"
          },
          {
            "Char": "*",
            "Replacement": "star"
          },
          {
            "Char": "\u0026",
            "Replacement": ""
          },
          {
            "Char": "?",
            "Replacement": ""
          },
          {
            "Char": "\u00E6",
            "Replacement": "ae"
          },
          {
            "Char": "\u00F8",
            "Replacement": "oe"
          },
          {
            "Char": "\u00FC",
            "Replacement": "ue"
          },
          {
            "Char": "\u00DF",
            "Replacement": "ss"
          },
          {
            "Char": "|",
            "Replacement": "-"
          },
          {
            "Char": "\u003C",
            "Replacement": ""
          },
          {
            "Char": "\u003E",
            "Replacement": ""
          },
          {
            "Char": "\u00E5",
            "Replacement": "a"
          },
          {
            "Char": "\u00E4",
            "Replacement": "a"
          },
          {
            "Char": "\u00F6",
            "Replacement": "o"
          }
        ]
      },
      "Content": {
        "BackOfficeLogo": "../Icons/favicon_RM_64.png",
        "HideBackOfficeLogo": false,
        "LoginLogoImage": "../Icons/favicon_RM_64.png",
        "LoginLogoImageAlternative": "../Icons/favicon_RM_64.png",
        "Error404Collection": [
          {
            "Culture": "default",
            "ContentKey": "86ae9314-b790-4583-93b8-2480c09a1469"
          }
        ],
        "AllowEditInvariantFromNonDefault": true,
        "ContentVersionCleanupPolicy": {
          "EnableCleanup": true
        }
      },
      "Unattended": {
        "UpgradeUnattended": true
      },
      "Runtime": {
        "Mode": "Production"
      },
      "ModelsBuilder": {
        "ModelsMode": "Nothing"
      },
      "Security": {
        "AllowConcurrentLogins": false
      },
      "uSync": {
        "Settings": {
          "ExportAtStartup": "All",
          "ExportOnSave": true
        }
      }
    }
  },
  "AzureSSO": {
    "Credentials": {
      "Instance": "https://login.microsoftonline.com/",
      "Domain": "",
      "TenantId": "",
      "ClientId": "",
      "CallbackPath": "/umbraco-microsoft-signin/",
      "SignedOutCallbackPath ": "/umbraco-microsoft-signout/",
      "ClientSecret": ""
    },
    "DisplayName": "Azure AD",
    "Enabled": true,
    "DenyLocalLogin": true,
    "AutoRedirectLoginToExternalProvider": false,
    "TokenCacheType": "InMemory",
    "GroupBindings": {
      "1c45a75a-30f2-4bef-aa73-040235d9cd58": "admin"
    },
    "SetGroupsOnLogin": true,
    "DefaultGroups": [
      "admin"
    ],
    "LogUnmappedRolesAsWarning": false,
    "Icon": "icon-cloudy"
  },
  "ConnectionStrings": {
    "umbracoDbDSN": "",
    "umbracoDbDSN_ProviderName": "Microsoft.Data.SqlClient"
  }
}