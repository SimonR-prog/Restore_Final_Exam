@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<ContactPageViewModel>

@{
	Layout = "layout.cshtml";
    if (Model == null)
    {
        return;
    }
}

@section Styles {
	<link rel="stylesheet" href="~/css/contactPage.css" />
}

<section class="section_contact">
    <h1>@Model.Title</h1>
    <div aria-hidden="true" class="seperator"></div>

	<div class="contact-map">
        <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d66327.35650155006!2d11.935131764793182!3d57.674563811395025!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x464ff21ef7f59361%3A0x35d74fa42b32ef8c!2sBagg%C3%A5kersgatan%208%2C%20431%2053%20M%C3%B6lndal!5e0!3m2!1sen!2sse!4v1777988612181!5m2!1sen!2sse" 
            style="border:0;" 
            allowfullscreen="" 
            loading="lazy" 
            referrerpolicy="no-referrer-when-downgrade"
            aria-label="Google-karta som visar vart verkstaden befinner sig. Adress: @Model.Adress Postnummer: @Model.Postal Stad: @Model.City">
        </iframe>
	</div>

    <h2>@Model.ContactTitle</h2>
    <div aria-hidden="true" class="seperator"></div>
    <div class="contact-cards">
        <a class="contact-card" href="mailto:@Model.Email">
            <div class="contact-card-icon">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640"><path fill="currentColor" d="M125.4 128C91.5 128 64 155.5 64 189.4C64 190.3 64 191.1 64.1 192L64 192L64 448C64 483.3 92.7 512 128 512L512 512C547.3 512 576 483.3 576 448L576 192L575.9 192C575.9 191.1 576 190.3 576 189.4C576 155.5 548.5 128 514.6 128L125.4 128zM528 256.3L528 448C528 456.8 520.8 464 512 464L128 464C119.2 464 112 456.8 112 448L112 256.3L266.8 373.7C298.2 397.6 341.7 397.6 373.2 373.7L528 256.3zM112 189.4C112 182 118 176 125.4 176L514.6 176C522 176 528 182 528 189.4C528 193.6 526 197.6 522.7 200.1L344.2 335.5C329.9 346.3 310.1 346.3 295.8 335.5L117.3 200.1C114 197.6 112 193.6 112 189.4z" /></svg>
            </div>
            <div class="contact-card-text">
                <p class="contact-card-label">E-Mail</p>
                <p class="contact-card-value">@Model.Email</p>
            </div>
        </a>
        <a class="contact-card" href="tel:+@Model.PhoneNumberHref">
            <div class="contact-card-icon">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640"><path fill="currentColor" d="M224.2 89C216.3 70.1 195.7 60.1 176.1 65.4L170.6 66.9C106 84.5 50.8 147.1 66.9 223.3C104 398.3 241.7 536 416.7 573.1C493 589.3 555.5 534 573.1 469.4L574.6 463.9C580 444.2 569.9 423.6 551.1 415.8L453.8 375.3C437.3 368.4 418.2 373.2 406.8 387.1L368.2 434.3C297.9 399.4 241.3 341 208.8 269.3L253 233.3C266.9 222 271.6 202.9 264.8 186.3L224.2 89z" /></svg>
            </div>
            <div class="contact-card-text">
                <p class="contact-card-label">Telefon</p>
                <p class="contact-card-value">@Model.PhoneNumber</p>
            </div>
        </a>
    </div>
</section>