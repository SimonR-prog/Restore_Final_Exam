@model Restore_Presentation.Models.ViewModels.SocialMediaIconViewModel

@{
    if (Model == null)
    {
        return;
    }

    var icons = Model.SocialMediaIcons;
    if (icons == null || !icons.Any())
    {
        return;
    }
}

<section class="section_social-media-icons">
    <ul>
        @foreach (var icon in icons)
        {
            var fontAwesomeIcon = icon?.SocialMedia?.ToLower();

            @if (!string.IsNullOrWhiteSpace(icon?.Link?.Url))
            {
                <li class="social-media-list-item">
                    <a class="social-media-anchor" href="@icon?.Link?.Url"
                       target="_blank" rel="noopener noreferrer"
                       aria-label="Besök oss på @icon?.SocialMedia">
                        <span class="social-media-icon" aria-hidden="true">
                            @switch (fontAwesomeIcon)
                            {
                                case "facebook":
                                    <svg viewBox="0 0 320 512">
                                        <path fill="currentColor" d="M279.14 288l14.22-92.66h-88.91v-60.13c0-25.35 12.42-50.06 52.24-50.06H297V6.26S260.43 0 225.36 0c-73.22 0-121.08 44.38-121.08 124.72v70.62H22.89V288h81.39v224h100.17V288z" />
                                    </svg>
                                    break;

                                case "linkedin":
                                    <svg viewBox="0 0 448 512">
                                        <path fill="currentColor" d="M100.28 448H7.4V148.9h92.88zm-46.44-340C24.3 108 0 83.7 0 53.84A53.84 53.84 0 0 1 53.84 0C83.7 0 108 24.3 108 53.84c0 29.86-24.3 54.16-54.16 54.16zM447.9 448h-92.68V302.4c0-34.7-.7-79.2-48.29-79.2-48.3 0-55.7 37.7-55.7 76.7V448h-92.78V148.9h89.08v40.8h1.3c12.4-23.5 42.6-48.3 87.7-48.3 93.8 0 111.1 61.7 111.1 141.9V448z" />
                                    </svg>
                                    break;

                                case "twitter":
                                    <svg viewBox="0 0 512 512">
                                        <path fill="currentColor" d="M389.2 48h70.6L306.6 224.2 480 464H344.6L236.6 318.6 106.2 464H35.6l164-183.5L32 48h139.5l97.4 131.3L389.2 48z" />
                                    </svg>
                                    break;

                                case "instagram":
                                    <svg viewBox="0 0 448 512">
                                        <path fill="currentColor" d="M224.1 141c-63.6 0-115.1 51.5-115.1 115.1S160.5 371.2 224.1 371.2 339.2 319.7 339.2 256.1 287.7 141 224.1 141zm0 189.6c-41.1 0-74.5-33.4-74.5-74.5s33.4-74.5 74.5-74.5 74.5 33.4 74.5 74.5-33.4 74.5-74.5 74.5zm146.4-194.3c0 14.9-12 26.9-26.9 26.9-14.9 0-26.9-12-26.9-26.9 0-14.9 12-26.9 26.9-26.9 14.8 0 26.9 12 26.9 26.9zM398.8 80.2c-22.9-22.9-53.5-35.5-85.8-35.5H135c-32.2 0-62.9 12.6-85.8 35.5C26.3 103.1 13.7 133.7 13.7 166v180c0 32.2 12.6 62.9 35.5 85.8 22.9 22.9 53.5 35.5 85.8 35.5h178c32.2 0 62.9-12.6 85.8-35.5 22.9-22.9 35.5-53.5 35.5-85.8V166c0-32.3-12.6-62.9-35.5-85.8zM398 346c0 22.5-8.8 43.7-24.7 59.6-15.9 15.9-37.1 24.7-59.6 24.7H135c-22.5 0-43.7-8.8-59.6-24.7-15.9-15.9-24.7-37.1-24.7-59.6V166c0-22.5 8.8-43.7 24.7-59.6 15.9-15.9 37.1-24.7 59.6-24.7h178c22.5 0 43.7 8.8 59.6 24.7 15.9 15.9 24.7 37.1 24.7 59.6V346z" />
                                    </svg>
                                    break;

                                case "youtube":
                                    <svg viewBox="0 0 640 640">
                                        <path fill="currentColor" d="M581.7 188.1C575.5 164.4 556.9 145.8 533.4 139.5C490.9 128 320.1 128 320.1 128C320.1 128 149.3 128 106.7 139.5C83.2 145.8 64.7 164.4 58.4 188.1C47 231 47 320.4 47 320.4C47 320.4 47 409.8 58.4 452.7C64.7 476.3 83.2 494.2 106.7 500.5C149.3 512 320.1 512 320.1 512C320.1 512 490.9 512 533.5 500.5C557 494.2 575.5 476.3 581.8 452.7C593.2 409.8 593.2 320.4 593.2 320.4C593.2 320.4 593.2 231 581.8 188.1zM264.2 401.6L264.2 239.2L406.9 320.4L264.2 401.6z" />
                                    </svg>
                                    break;
                            }
                        </span>
                    </a>
                </li>
            }
        }
    </ul>
</section>