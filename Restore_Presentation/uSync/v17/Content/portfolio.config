      "udi": null,
      "values": [
        {
          "alias": "title",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "N\u00E4r \u00E4r det dags att kontakta en restaurerare?"
        },
        {
          "alias": "description",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "Layout": {}
            },
            "markup": "\u003Cp\u003EEtt tydligt tecken \u00E4r n\u00E4r fogarna i en stol b\u00F6rjar sl\u00E4ppa. Den k\u00E4nns kanske svajig, knarrar eller r\u00F6r sig n\u00E4r du sitter.\u003C/p\u003E\u003Cp\u003EDet kan vara lockande att v\u00E4nta, men ju tidigare man \u00E5tg\u00E4rdar problemet, desto enklare (och billigare) blir det.\u003C/p\u003E\u003Cp\u003EI det h\u00E4r exemplet \u00E5tg\u00E4rdades problemen i r\u00E4tt tid.\u003C/p\u003E"
          }
        },
        {
          "alias": "images",
