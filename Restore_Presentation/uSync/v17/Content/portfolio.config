    },
    {
      "contentTypeKey": "5c14d44e-74ac-4885-a0c5-4e4459562bc5",
      "key": "6d33d986-0ea5-46dc-9ace-1ece51da017e",
      "udi": null,
      "values": [
        {
          "alias": "title",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Teak bord"
        },
        {
          "alias": "description",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "Layout": {}
            },
            "markup": "\u003Cp\u003EEtt vackert runt bord i teak kom in till verkstan med en tydlig fuktfl\u00E4ck i mitten, efter en kruka som f\u00E5tt st\u00E5 f\u00F6r l\u00E4nge.\u003C/p\u003E\u003Cp\u003EGenom lite restaureringsmagi och arbete \u00E4r fl\u00E4cken nu borta och bordet har f\u00E5tt en ny ytbehandling som \u00E5ter lyfter fram tr\u00E4ets djup och v\u00E4rme.\u003C/p\u003E"
          }
        },
