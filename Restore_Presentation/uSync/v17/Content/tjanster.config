        {
          "alias": "title",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Reng\u00F6ring, uppfr\u00E4schning och v\u00E5rd"
        },
        {
          "alias": "text",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Reng\u00F6ring och omv\u00E5rdnad av tr\u00E4, fan\u00E9r och beslag f\u00F6r att fr\u00E4scha upp utan att f\u00F6r\u00E4ndra originalet."
        }
      ]
    },
    {
      "contentTypeKey": "af34977f-9135-4a4a-b059-8df0a84274d1",
