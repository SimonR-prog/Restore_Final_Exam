      "udi": null,
      "values": [
        {
          "alias": "title",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Lagning och limning"
        },
        {
          "alias": "text",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Reparation av skador, sprickor och l\u00F6sa delar f\u00F6r att \u00E5terst\u00E4lla m\u00F6belns stabilitet och funktion."
        }
      ]
    },
    {
      "contentTypeKey": "af34977f-9135-4a4a-b059-8df0a84274d1",
