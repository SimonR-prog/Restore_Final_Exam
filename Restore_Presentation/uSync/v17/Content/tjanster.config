      "udi": null,
      "values": [
        {
          "alias": "title",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Bevarande av ytbehandling"
        },
        {
          "alias": "text",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Skonsamt underh\u00E5ll av befintlig yta f\u00F6r att beh\u00E5lla m\u00F6belns \u00E5lder, karakt\u00E4r och originalk\u00E4nsla."
        }
      ]
    },
    {
      "contentTypeKey": "af34977f-9135-4a4a-b059-8df0a84274d1",
      "key": "ab09ad79-ffa8-4b25-9058-4a542a0d0e76",
      "udi": null,
      "values": [
        {
          "alias": "title",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Retuschering och traditonella ytbehandlingar"
        },
        {
          "alias": "text",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Finslipning av sm\u00E5 skador, f\u00E4rgjustering och anv\u00E4ndning av klassiska tekniker s\u00E5som schellackpolering."
        }
      ]
    },
    {
      "contentTypeKey": "af34977f-9135-4a4a-b059-8df0a84274d1",
      "key": "5843d6c2-154a-4410-a34f-5cda8fea8572",
